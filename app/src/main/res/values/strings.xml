    <!-- 7 Kebiasaan Anak Indonesia Hebat -->
    <string name="habit_1_title">Bangun Pagi</string>
    <string name="habit_1_desc">Bangun sebelum azan subuh / pukul 05.00 pagi dengan segar dan mandiri.</string>
    <string name="habit_2_title">Beribadah</string>
    <string name="habit_2_desc">Menjalankan ibadah dan berdoa sesuai agama dan kepercayaan masing-masing.</string>
    <string name="habit_3_title">Berolahraga</string>
    <string name="habit_3_desc">Melakukan senam pagi, olahraga ringan, atau aktivitas fisik minimal 15–30 menit.</string>
    <string name="habit_4_title">Makan Sehat dan Bergizi</string>
    <string name="habit_4_desc">Sarapan dan makan bergizi seimbang dengan sayur, lauk, buah, dan air putih.</string>
    <string name="habit_5_title">Gemar Membaca</string>
    <string name="habit_5_desc">Membaca buku pelajaran atau cerita bermakna minimal 15 menit setiap hari.</string>
    <string name="habit_6_title">Bermasyarakat / Tolong Menolong</string>
    <string name="habit_6_desc">Membantu orang tua di rumah, gotong royong, atau menolong teman di sekolah.</string>
    <string name="habit_7_title">Tidur Tepat Waktu</string>
    <string name="habit_7_desc">Tidur malam tepat waktu sebelum pukul 21.30 untuk menjaga kesehatan tubuh.</string>

